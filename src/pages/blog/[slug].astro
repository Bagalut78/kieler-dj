---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Generate static paths for all blog posts
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Helper to format date
const formatDate = (date: Date) => {
  return date.toLocaleDateString('de-DE', {
    day: '2-digit',
    month: 'long',
    year: 'numeric'
  });
};
---

<Layout 
  title={`${post.data.title} | DJ-Blog | Kieler-DJ`}
  description={post.data.description}
>
  <Header />

  <main class="blog-detail-page">
    <div class="container">
      <!-- Back Button -->
      <a href="/blog" class="back-link">
        <span class="arrow">←</span> Zurück zum Blog
      </a>

      <!-- Article Header -->
      <header class="post-header">
        <div class="post-meta">
          <span class="post-date">{formatDate(post.data.pubDate)}</span>
          {post.data.minutesToRead && <span class="post-read-time">⏱ {post.data.minutesToRead} Lesezeit</span>}
        </div>
        <h1 style="color: #121212 !important; -webkit-text-stroke: 0px transparent !important; -webkit-text-fill-color: #121212 !important;">{post.data.title}</h1>
        <p class="post-lead" style="color: #333333 !important;">{post.data.description}</p>
      </header>

      <!-- Article Content -->
      <article class="post-content" style="background-color: #ffffff !important; background-image: none !important; color: #121212 !important; border: 3px solid #121212 !important; box-shadow: 8px 8px 0px #121212 !important; padding: 3rem !important;">
        <Content />
      </article>

      <!-- Mini-CTA at bottom -->
      <section class="post-footer-cta" style="background-color: #fcfaf2 !important; border: 3px solid #121212 !important; box-shadow: 8px 8px 0px #121212 !important; padding: 3rem !important;">
        <h3 style="color: #121212 !important; -webkit-text-stroke: 0px transparent !important;">Du planst dein eigenes Event?</h3>
        <p style="color: #333333 !important;">Lass uns in einem unverbindlichen Gespräch darüber reden, wie wir deine Feier unvergesslich machen.</p>
        <div class="cta-btns">
          <a href="/#kalkulator" class="btn btn-primary">Preis online schätzen</a>
          <a href="/?contact=true" class="btn btn-secondary trigger-contact-modal">Jetzt anfragen</a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .blog-detail-page {
    padding: 8rem 0 5rem 0;
    min-height: 90vh;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-dark);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 2.5rem;
    text-transform: uppercase;
    border-bottom: 2px solid transparent;
    transition: var(--transition-brutal);
  }

  .back-link:hover {
    color: var(--color-accent-orange);
    border-bottom-color: var(--color-accent-orange);
  }

  .back-link:hover .arrow {
    transform: translateX(-4px);
  }

  .arrow {
    transition: transform var(--transition-brutal);
  }

  .post-header {
    max-width: 800px;
    margin: 0 auto 3rem auto;
    text-align: left;
  }

  .post-meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.9rem;
    color: #555555;
    font-weight: 700;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-header h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.15;
    margin-bottom: 1.5rem;
    font-weight: 900;
    color: var(--color-dark) !important;
    -webkit-text-stroke: none !important;
    text-transform: uppercase;
    font-family: var(--font-heading);
    letter-spacing: -0.02em;
  }

  .post-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #333333;
    font-weight: 500;
  }

  .post-content {
    max-width: 800px;
    margin: 0 auto 4rem auto;
    background-color: #ffffff !important;
    border: 3px solid #121212 !important;
    box-shadow: 8px 8px 0px #121212 !important;
    padding: 3rem;
    color: #121212 !important;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Typography styles for MD contents */
  .post-content :global(h2) {
    font-size: 1.6rem;
    margin: 2.5rem 0 1rem 0;
    color: #121212 !important;
    text-align: left;
    font-weight: 900;
    font-family: var(--font-heading);
    text-transform: uppercase;
  }

  .post-content :global(h3) {
    font-size: 1.25rem;
    margin: 2rem 0 1rem 0;
    color: #121212 !important;
    font-weight: 900;
    font-family: var(--font-heading);
    text-transform: uppercase;
  }

  .post-content :global(p) {
    font-size: 1.05rem;
    line-height: 1.72;
    color: #121212 !important;
    margin-bottom: 1.5rem;
  }

  .post-content :global(strong) {
    color: #000000 !important;
    font-weight: 700;
  }

  .post-content :global(ul), .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    color: #121212 !important;
  }

  .post-content :global(li) {
    font-size: 1.05rem;
    line-height: 1.72;
    margin-bottom: 0.5rem;
  }

  .post-content :global(a) {
    color: var(--color-accent-orange);
    text-decoration: underline;
    font-weight: bold;
  }

  .post-content :global(a:hover) {
    color: var(--color-accent-green);
    background-color: var(--color-dark);
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--color-accent-orange);
    padding: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #121212 !important;
    background: #fcfaf2;
    border-top: 1px solid #121212;
    border-right: 1px solid #121212;
    border-bottom: 1px solid #121212;
    box-shadow: 4px 4px 0px #121212;
  }

  .post-content :global(blockquote p) {
    margin-bottom: 0;
  }

  /* Embedded images in markdown posts */
  .post-content :global(img) {
    width: 100%;
    height: auto;
    object-fit: cover;
    border: 3px solid #121212;
    box-shadow: 6px 6px 0px #121212;
    margin-bottom: 2rem;
    border-radius: var(--radius-brutal);
  }

  .post-footer-cta {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    background-color: var(--color-bg-paper) !important;
    border: 3px solid #121212 !important;
    box-shadow: 8px 8px 0px #121212 !important;
    padding: 3rem;
  }

  .post-footer-cta h3 {
    font-size: 1.6rem;
    font-family: var(--font-heading);
    text-transform: uppercase;
    color: var(--color-dark);
    margin-bottom: 0.5rem;
    font-weight: 900;
  }

  .post-footer-cta p {
    color: #333333;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .cta-btns {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 600px) {
    .post-content {
      padding: 1.5rem;
    }
    .post-footer-cta {
      padding: 2rem 1.5rem;
    }
    .cta-btns {
      flex-direction: column;
      width: 100%;
    }
    .cta-btns .btn {
      width: 100%;
    }
  }
</style>
