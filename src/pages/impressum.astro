---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Impressum | Kieler-DJ"
  description="Impressum und rechtliche Angaben für Kieler-DJ DJ-Services."
>
  <Header />

  <main class="legal-page">
    <div class="container">
      <div class="brutal-card legal-card">
        <h1>Impressum</h1>
        <p class="last-updated">Stand: Mai 2026</p>
        
        <section class="legal-section">
          <h2>Angaben gemäß § 5 TMG</h2>
          <p>
            Matthias Gawlich<br />
            Köhlerkoppel 22B<br />
            24109 Melsdorf
          </p>
        </section>

        <section class="legal-section">
          <h2>Kontakt</h2>
          <p>
            Telefon: 01621866354<br />
            E-Mail: matthias.gawlich@gmail.com
          </p>
        </section>

        <section class="legal-section">
          <h2>Umsatzsteuer-ID</h2>
          <p>
            Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz:<br />
            <strong>DE322576320</strong>
          </p>
        </section>

        <section class="legal-section">
          <h2>Verbraucherstreitbeilegung/Universalschlichtungsstelle</h2>
          <p>
            Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
          </p>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .legal-page {
    padding: 8rem 0 4rem 0;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .legal-card {
    max-width: 800px;
    margin: 0 auto;
    background-color: #ffffff !important;
    border: 3px solid #121212 !important;
    box-shadow: 8px 8px 0px #121212 !important;
    padding: 3rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #121212 !important;
  }

  .legal-card h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: #121212 !important;
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .last-updated {
    font-size: 0.9rem;
    color: #555555 !important;
    margin-bottom: 2.5rem;
  }

  .legal-section {
    margin-bottom: 2rem;
    border-bottom: 2px dashed rgba(18, 18, 18, 0.15);
    padding-bottom: 1.5rem;
  }

  .legal-section:last-of-type {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .legal-section h2 {
    font-size: 1.4rem;
    margin-bottom: 1rem;
    text-align: left;
    color: #121212 !important;
    font-family: var(--font-heading);
    text-transform: uppercase;
  }

  .legal-section p {
    font-size: 1rem;
    line-height: 1.7;
    color: #121212 !important;
    margin-bottom: 0;
  }

  .legal-section strong {
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .legal-card {
      padding: 1.5rem;
    }
    .legal-card h1 {
      font-size: 2rem;
    }
  }
</style>
