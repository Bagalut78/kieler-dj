---
import { Image } from 'astro:assets';
import logoImg from '../assets/kieler-dj-logo.jpg';

const currentYear = new Date().getFullYear();
---

<footer class="zine-footer">
  <div class="container footer-grid">
    <!-- Brand Stamp Column -->
    <div class="footer-col brand-col">
      <a href="/" class="footer-logo-stamp-link">
        <Image src={logoImg} alt="Kieler-DJ Logo" class="footer-logo-stamp-img" />
      </a>
      <p class="brand-desc">
        PROFESSIONELLE DJ-DIENSTLEISTUNG FÜR HOCHZEITEN, GEBURTSTAGE & FIRMEN-EVENTS IN KIEL & SH.
      </p>
      

    </div>
    
    <!-- Link Columns -->
    <div class="footer-col links-col">
      <h3>Navigation</h3>
      <ul class="footer-links">
        <li><a href="/#leistungen">/ Leistungen</a></li>
        <li><a href="/#kalkulator">/ Preiskalkulator</a></li>
        <li><a href="/#mixes">/ Mixes & Playlists</a></li>
        <li><a href="/blog">/ DJ-Blog</a></li>
      </ul>
    </div>
    
    <div class="footer-col links-col">
      <h3>Events</h3>
      <ul class="footer-links">
        <li><a href="/#leistungen">/ Hochzeiten</a></li>
        <li><a href="/#leistungen">/ Geburtstage</a></li>
        <li><a href="/#leistungen">/ Firmen-Events</a></li>
      </ul>
    </div>

    <div class="footer-col links-col">
      <h3>Rechtliches</h3>
      <ul class="footer-links">
        <li><a href="/impressum">/ Impressum</a></li>
        <li><a href="/datenschutz">/ Datenschutz</a></li>
        <li><a href="/#faq">/ FAQ</a></li>
        <li><a href="/?contact=true" class="trigger-contact-modal">/ Jetzt anfragen</a></li>
      </ul>
    </div>
  </div>
  
  <div class="footer-bottom">
    <div class="container footer-bottom-flex">
      <p class="copyright-stamp">
        &copy; {currentYear} KIELER-DJ // ALLE RECHTE VORBEHALTEN // HANDGEMACHT IN MELSDORF/KIEL.
      </p>
      <p class="credit-stamp">Mit ❤️ in Melsdorf gemacht</p>
    </div>
  </div>
</footer>

<style>
  .zine-footer {
    background-color: var(--color-dark);
    color: var(--color-bg-paper);
    border-top: var(--border-brutal);
    padding: 5rem 0 2.5rem 0;
    position: relative;
    z-index: 10;
    font-family: var(--font-mono);
  }
  
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }
  
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }
  
  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  
  .logo {
    display: flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--color-dark);
    background-color: var(--color-accent-yellow);
    border: 3px solid var(--color-bg-paper);
    box-shadow: 4px 4px 0px var(--color-bg-paper);
    border-radius: 0;
  }
  
  .logo-box {
    background-color: var(--color-dark);
    color: var(--color-accent-yellow);
    padding: 0 0.4rem;
    margin-right: 0.3rem;
  }

  /* Footer Logo Stamp */
  .footer-logo-stamp-link {
    display: flex;
    align-items: center;
    height: 60px;
    transition: transform var(--transition-brutal);
    margin-bottom: 0.5rem;
  }

  .footer-logo-stamp-link:hover {
    transform: rotate(1.5deg) scale(1.05);
  }

  .footer-logo-stamp-img {
    height: 100%;
    width: auto;
    object-fit: contain;
    border: 2px solid var(--color-bg-paper);
    box-shadow: 4px 4px 0px var(--color-bg-paper);
    background-color: var(--color-bg-paper);
  }
  
  .brand-desc {
    max-width: 320px;
    font-size: 0.85rem;
    font-weight: bold;
    line-height: 1.5;
    color: #a0a0a0;
  }
  
  .social-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  
  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.75rem;
    border: 2px solid var(--color-bg-paper);
    background-color: transparent;
    color: var(--color-bg-paper);
    font-size: 0.8rem;
    font-weight: 700;
    transition: var(--transition-brutal);
  }
  
  .social-icon:hover {
    color: var(--color-dark);
    background-color: var(--color-accent-green);
    border-color: var(--color-dark);
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0px var(--color-bg-paper);
  }
  
  .footer-col h3 {
    font-size: 1rem;
    font-weight: 900;
    margin-bottom: 1.5rem;
    color: var(--color-accent-yellow);
    text-transform: uppercase;
    font-family: var(--font-heading);
    border-bottom: 2px dashed rgba(255, 255, 255, 0.2);
    padding-bottom: 0.5rem;
  }
  
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .footer-links a {
    color: #cccccc;
    font-size: 0.9rem;
    font-weight: bold;
  }
  
  .footer-links a:hover {
    color: var(--color-accent-green);
    padding-left: 6px;
  }
  
  .footer-bottom {
    border-top: 2px dashed rgba(255, 255, 255, 0.1);
    padding-top: 2.5rem;
  }
  
  .footer-bottom-flex {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    text-align: center;
    font-size: 0.8rem;
    font-weight: bold;
    color: #777777;
  }
  
  @media (min-width: 768px) {
    .footer-bottom-flex {
      flex-direction: row;
      text-align: left;
    }
  }
  
  .copyright-stamp {
    letter-spacing: 0.05em;
  }

  .credit-stamp {
    background-color: #222222;
    color: var(--color-accent-yellow);
    padding: 0.2rem 0.5rem;
    border: 1px solid #333333;
  }
</style>
