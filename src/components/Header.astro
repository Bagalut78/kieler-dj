---
import { Image } from 'astro:assets';
import logoImg from '../assets/kieler-dj-logo.jpg';
---

<header class="zine-header">
  <!-- Top Ticker Tape -->
  <div class="ticker-tape">
    <div class="ticker-content">
      <span>+++ VINYL VIBES +++ 100% LIVE MIXING +++ JETZT TERMIN FÜR 2026 SICHERN +++ KIELER-DJ IN KIEL & SCHLESWIG-HOLSTEIN +++ </span>
      <span>+++ VINYL VIBES +++ 100% LIVE MIXING +++ JETZT TERMIN FÜR 2026 SICHERN +++ KIELER-DJ IN KIEL & SCHLESWIG-HOLSTEIN +++ </span>
    </div>
  </div>

  <div class="container header-container">
    <!-- Blocky Brand Logo Stamp -->
    <a href="/" class="header-logo-stamp-link">
      <Image src={logoImg} alt="Kieler-DJ Logo" class="header-logo-stamp-img" />
    </a>
    
    <!-- Desktop Navigation -->
    <nav class="nav-desktop">
      <a href="/#leistungen" class="nav-link">Leistungen</a>
      <a href="/#kalkulator" class="nav-link">Preiskalkulator</a>
      <a href="/#mixes" class="nav-link">Mixes</a>
      <a href="/#faq" class="nav-link">FAQ</a>
      <a href="/blog" class="nav-link">Blog</a>
      <a href="/?contact=true" class="btn btn-primary btn-sm-nav trigger-contact-modal">Jetzt anfragen</a>
    </nav>
    
    <!-- Mobile Menu Button -->
    <button class="mobile-menu-btn" aria-label="Menu öffnen" aria-expanded="false" id="menuToggle">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
  
  <!-- Mobile Navigation Overlay -->
  <nav class="nav-mobile" id="mobileNav">
    <a href="/#leistungen" class="mobile-nav-link">Leistungen</a>
    <a href="/#kalkulator" class="mobile-nav-link">Preiskalkulator</a>
    <a href="/#mixes" class="mobile-nav-link">Mixes</a>
    <a href="/#faq" class="mobile-nav-link">FAQ</a>
    <a href="/blog" class="mobile-nav-link">Blog</a>
    <a href="/?contact=true" class="btn btn-primary mobile-nav-btn trigger-contact-modal">Jetzt anfragen</a>
  </nav>
</header>

<style>
  .zine-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background-color: var(--color-bg-paper);
    border-bottom: var(--border-brutal);
  }

  /* Top Ticker Tape */
  .ticker-tape {
    background-color: var(--color-dark);
    color: var(--color-accent-yellow);
    border-bottom: 2px solid var(--color-dark);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 0;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
  }

  .ticker-content {
    display: inline-block;
    animation: ticker-slide 30s linear infinite;
  }

  .ticker-content span {
    display: inline-block;
    padding-right: 2rem;
  }

  @keyframes ticker-slide {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }
  
  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 75px;
  }
  
  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--color-dark);
    background-color: var(--color-white);
    letter-spacing: -0.03em;
    box-shadow: 4px 4px 0px var(--color-dark);
    border-radius: 0;
  }
  
  .logo:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--color-dark);
    background-color: var(--color-accent-yellow);
  }

  .logo-box {
    background-color: var(--color-dark);
    color: var(--color-accent-yellow);
    padding: 0 0.4rem;
    margin-right: 0.3rem;
  }

  /* Header Logo Stamp */
  .header-logo-stamp-link {
    display: flex;
    align-items: center;
    height: 52px;
    transition: transform var(--transition-brutal);
  }

  .header-logo-stamp-link:hover {
    transform: rotate(-1.5deg) scale(1.05);
  }

  .header-logo-stamp-img {
    height: 100%;
    width: auto;
    object-fit: contain;
    border: 2px solid var(--color-dark);
    box-shadow: 3px 3px 0px var(--color-dark);
    background-color: var(--color-bg-paper);
  }
  
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 1.5rem;
  }
  
  @media (min-width: 768px) {
    .nav-desktop {
      display: flex;
    }
  }
  
  .nav-link {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-dark);
    padding: 0.35rem 0.75rem;
    border: 2px solid transparent;
    text-transform: uppercase;
  }
  
  .nav-link:hover {
    background-color: var(--color-accent-green);
    border: 2px solid var(--color-dark);
    box-shadow: 3px 3px 0px var(--color-dark);
    transform: translate(-2px, -2px);
  }
  
  .btn-sm-nav {
    padding: 0.5rem 1rem;
    font-size: 0.95rem;
    box-shadow: 3px 3px 0px var(--color-dark);
  }

  .btn-sm-nav:hover {
    box-shadow: 5px 5px 0px var(--color-dark);
  }
  
  /* Mobile Menu Button */
  .mobile-menu-btn {
    display: block;
    background: var(--color-white);
    border: var(--border-brutal);
    cursor: pointer;
    width: 44px;
    height: 44px;
    position: relative;
    z-index: 110;
    box-shadow: 3px 3px 0px var(--color-dark);
    transition: var(--transition-brutal);
  }

  .mobile-menu-btn:hover {
    background: var(--color-accent-green);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px var(--color-dark);
  }

  .mobile-menu-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0px var(--color-dark);
  }
  
  @media (min-width: 768px) {
    .mobile-menu-btn {
      display: none;
    }
  }
  
  .bar {
    display: block;
    width: 24px;
    height: 3px;
    background-color: var(--color-dark);
    margin: 5px auto;
    transition: var(--transition-brutal);
  }
  
  /* Hamburger menu transforms */
  .mobile-menu-btn.active .bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  
  .mobile-menu-btn.active .bar:nth-child(2) {
    opacity: 0;
  }
  
  .mobile-menu-btn.active .bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
  
  /* Mobile Navigation Overlay */
  .nav-mobile {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: var(--color-bg-paper);
    background-image: 
      radial-gradient(var(--color-dark) 0.5px, transparent 0.5px), 
      radial-gradient(var(--color-dark) 0.5px, var(--color-bg-paper) 0.5px);
    background-size: 20px 20px;
    background-position: 0 0, 10px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 2rem;
    transform: translateY(-100%);
    transition: transform var(--transition-brutal);
    z-index: 105;
    border-bottom: var(--border-brutal);
  }
  
  .nav-mobile.active {
    transform: translateY(0);
  }
  
  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--color-dark);
    text-transform: uppercase;
    background-color: var(--color-white);
    border: var(--border-brutal);
    padding: 0.5rem 2rem;
    width: 80%;
    max-width: 320px;
    text-align: center;
    box-shadow: var(--shadow-brutal-sm);
  }
  
  .mobile-nav-link:hover {
    background-color: var(--color-accent-yellow);
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-brutal);
  }
  
  .mobile-nav-btn {
    margin-top: 1rem;
    width: 80%;
    max-width: 320px;
  }
</style>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const mobileNav = document.getElementById('mobileNav');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link, .mobile-nav-btn');

  if (menuToggle && mobileNav) {
    const toggleMenu = () => {
      const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', (!isExpanded).toString());
      menuToggle.classList.toggle('active');
      mobileNav.classList.toggle('active');
      document.body.style.overflow = isExpanded ? '' : 'hidden';
    };

    menuToggle.addEventListener('click', toggleMenu);

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.classList.remove('active');
        mobileNav.classList.remove('active');
        document.body.style.overflow = '';
      });
    });
  }
</script>
